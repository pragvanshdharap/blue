# 3) Test program — `ads131m08_regtest.c`

Drop this file into your project (next to `ads131m08.c/.h`). It assumes you already have CubeMX `MX_*_Init()` functions and a `huart1` UART handle (like in your existing `main.c`). If your UART handle is named differently, change the `extern` declaration.

* What it does: initializes HAL peripherals (calls your MX init stubs), sets up an `ADS131_Handle_t` instance, calls `ADS131M08_Init()`, then reads and prints a useful set of registers (ID, STATUS, MODE, CLOCK, GAIN1/2, CFG, threshold, per-channel CFG and calibration registers and CRC register if present). Useful to paste into your existing project or run as a debug binary.

```c
/* ads131m08_regtest.c
 *
 * Test program: reads and logs ADS131M08 registers after init.
 * Usage:
 *   - Include this file in your project.
 *   - Ensure MX_GPIO_Init(), MX_SPIx_Init(), MX_USARTx_UART_Init() exist (CubeMX stubs).
 *   - Ensure huart1 is available (or change to your UART handle).
 *
 * Build: add to your project and call ADS131M08_RegisterTest_Main() from main() or make it a program's main.
 */

#include <stdio.h>
#include <stdarg.h>
#include <string.h>
#include "ads131m08.h"
#include "main.h" /* or include correct header that provides SystemClock_Config, MX_*_Init, and extern huart1 */

/* If your project doesn't have main.h, replace the prototypes below with your own */
extern UART_HandleTypeDef huart1;
extern void SystemClock_Config(void);
extern void MX_GPIO_Init(void);
extern void MX_SPI1_Init(void);
extern void MX_SPI2_Init(void);
extern void MX_USART1_UART_Init(void);

/* Simple debug print over UART */
static void debug_print(const char *fmt, ...)
{
    char buf[256];
    va_list ap;
    va_start(ap, fmt);
    int len = vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    if (len > 0) {
        HAL_UART_Transmit(&huart1, (uint8_t*)buf, (uint16_t)len, HAL_MAX_DELAY);
    }
}

/* Log a single register (16-bit) */
static void log_reg_u16(ADS131_Handle_t *h, uint8_t addr, const char *name)
{
    uint16_t val = 0;
    HAL_StatusTypeDef st = ADS131M08_ReadRegister(h, addr, &val);
    if (st == HAL_OK) {
        debug_print("%s (0x%02X) = 0x%04X\r\n", name ? name : "REG", addr, val);
    } else {
        debug_print("%s (0x%02X) read FAILED\r\n", name ? name : "REG", addr);
    }
}

/* Reads and prints all logical registers (ID, STATUS, MODE, CLOCK, GAINs, CFG,
   threshold MSB/LSB, per-channel CFG/OCAL/GCAL and CRC) */
void ADS131M08_LogAllRegisters(ADS131_Handle_t *h)
{
    if (h == NULL) {
        debug_print("ADS handle is NULL\r\n");
        return;
    }

    debug_print("=== ADS131M08 register dump start ===\r\n");

    /* core registers */
    log_reg_u16(h, ADS131M08_REG_ID,     "ID");
    log_reg_u16(h, ADS131M08_REG_STATUS, "STATUS");
    log_reg_u16(h, ADS131M08_REG_MODE,   "MODE");
    log_reg_u16(h, ADS131M08_REG_CLOCK,  "CLOCK");
    log_reg_u16(h, ADS131M08_REG_GAIN1,  "GAIN1");
    log_reg_u16(h, ADS131M08_REG_GAIN2,  "GAIN2");
    log_reg_u16(h, ADS131M08_REG_CFG,    "CFG");
    log_reg_u16(h, ADS131M08_REG_THRSHLD_MSB, "THRSHLD_MSB");
    log_reg_u16(h, ADS131M08_REG_THRSHLD_LSB, "THRSHLD_LSB");

    /* per-channel registers (CHn_CFG + OCAL/GCAL MSB/LSB)
       header defines in ads131m08.h:
         ADS131M08_REG_CHn_CFG(n)
         ADS131M08_REG_CHn_OCAL_MSB(n)
         ADS131M08_REG_CHn_OCAL_LSB(n)
         ADS131M08_REG_CHn_GCAL_MSB(n)
         ADS131M08_REG_CHn_GCAL_LSB(n)
    */
    for (uint8_t ch = 0; ch < ADS131M08_NUM_CHANNELS; ++ch) {
        char name[40];
        uint8_t addr;

        addr = (uint8_t)ADS131M08_REG_CHn_CFG(ch);
        snprintf(name, sizeof(name), "CH%u_CFG", (unsigned)ch);
        log_reg_u16(h, addr, name);

        addr = (uint8_t)ADS131M08_REG_CHn_OCAL_MSB(ch);
        snprintf(name, sizeof(name), "CH%u_OCAL_MSB", (unsigned)ch);
        log_reg_u16(h, addr, name);

        addr = (uint8_t)ADS131M08_REG_CHn_OCAL_LSB(ch);
        snprintf(name, sizeof(name), "CH%u_OCAL_LSB", (unsigned)ch);
        log_reg_u16(h, addr, name);

        addr = (uint8_t)ADS131M08_REG_CHn_GCAL_MSB(ch);
        snprintf(name, sizeof(name), "CH%u_GCAL_MSB", (unsigned)ch);
        log_reg_u16(h, addr, name);

        addr = (uint8_t)ADS131M08_REG_CHn_GCAL_LSB(ch);
        snprintf(name, sizeof(name), "CH%u_GCAL_LSB", (unsigned)ch);
        log_reg_u16(h, addr, name);
    }

    /* CRC register if present */
#ifdef ADS131M08_REG_CRC
    log_reg_u16(h, ADS131M08_REG_CRC, "CRC");
#endif

    debug_print("=== ADS131M08 register dump end ===\r\n");
}

/* Example test main function you can use instead of (or call from) your main().
 * If you already have main() and initializations, you can simply call:
 *    ADS131M08_LogAllRegisters(&ads_handle);
 * after calling ADS131M08_Init(&ads_handle);
 */
int ADS131M08_RegisterTest_Main(void)
{
    /* HAL and clock / peripherals init (CubeMX-generated stubs) */
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_SPI1_Init();
    MX_SPI2_Init();
    MX_USART1_UART_Init();

    debug_print("ADS131M08 register test starting...\r\n");

    /* Build ADS handle: update pins/ports to match your board wiring */
    ADS131_Handle_t ads;
    memset(&ads, 0, sizeof(ads));
    /* Example: if using SPI1 and GPIOA pins — update to your wiring */
    ads.hspi = &hspi1; /* or hspi2 */
    ads.CS_Port = ADS1_CS_GPIO_Port;   /* replace with actual CS port macro */
    ads.CS_Pin  = ADS1_CS_Pin;         /* replace with actual CS pin macro */
    ads.RESET_Port = ADS1_RESET_GPIO_Port;
    ads.RESET_Pin  = ADS1_RESET_Pin;
    ads.DRDY_Port = ADS1_DRDY_GPIO_Port;
    ads.DRDY_Pin  = ADS1_DRDY_Pin;

    /* Make sure CS high, reset high before init if your platform requires it */
    HAL_GPIO_WritePin(ads.CS_Port, ads.CS_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(ads.RESET_Port, ads.RESET_Pin, GPIO_PIN_SET);

    HAL_StatusTypeDef st = ADS131M08_Init(&ads);
    if (st != HAL_OK) {
        debug_print("ADS131M08_Init() FAILED\r\n");
        while (1) {
            HAL_Delay(500);
        }
    }
    debug_print("ADS131M08_Init() OK\r\n");

    /* Log all registers for debugging */
    ADS131M08_LogAllRegisters(&ads);

    /* Optionally loop reading frames or exit */
    while (1) {
        HAL_Delay(1000);
    }

    return 0;
}
```

