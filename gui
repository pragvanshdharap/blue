class LoginWindow:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("MILITARY SYSTEM ACCESS")
        self.root.geometry("500x400")
        self.root.resizable(False, False)
        self.root.configure(bg=COLORS['bg_dark'])

        self.center_window()
        self.create_login_interface()

    def center_window(self):
        self.root.update_idletasks()
        x = (self.root.winfo_screenwidth() // 2) - (500 // 2)
        y = (self.root.winfo_screenheight() // 2) - (400 // 2)
        self.root.geometry(f"500x400+{x}+{y}")

    def create_login_interface(self):
        main_frame = tk.Frame(self.root, bg=COLORS['bg_dark'], padx=40, pady=40)
        main_frame.pack(fill=tk.BOTH, expand=True)

        tk.Label(main_frame, text="⚡ CLASSIFIED ACCESS ⚡",
                 font=("Consolas", 20, "bold"),
                 bg=COLORS['bg_dark'], fg=COLORS['text_light']).pack(pady=(0, 40))

        tk.Label(main_frame, text="AUTHORIZATION ID:",
                 font=("Consolas", 12, "bold"),
                 bg=COLORS['bg_dark'], fg=COLORS['text_light']).pack(anchor=tk.W, pady=(0, 8))

        self.username_entry = tk.Entry(main_frame, font=("Consolas", 12), width=25,
                                       bg=COLORS['bg_medium'], fg=COLORS['text_light'],
                                       insertbackground=COLORS['text_light'])
        self.username_entry.pack(pady=(0, 20))
        self.username_entry.focus()

        tk.Label(main_frame, text="SECURITY CODE:",
                 font=("Consolas", 12, "bold"),
                 bg=COLORS['bg_dark'], fg=COLORS['text_light']).pack(anchor=tk.W, pady=(0, 8))

        self.password_entry = tk.Entry(main_frame, show="*", font=("Consolas", 12), width=25,
                                       bg=COLORS['bg_medium'], fg=COLORS['text_light'],
                                       insertbackground=COLORS['text_light'])
        self.password_entry.pack(pady=(0, 30))

        tk.Button(main_frame, text="🔓 AUTHENTICATE", command=self.login,
                  font=("Consolas", 12, "bold"), bg=COLORS['accent'],
                  fg=COLORS['text_light'], activebackground=COLORS['button_active'],
                  activeforeground=COLORS['text_light'], width=20, height=2).pack(pady=15)

        self.root.bind('<Return>', lambda event: self.login())

        self.status_label = tk.Label(main_frame, text="", font=("Consolas", 10),
                                     bg=COLORS['bg_dark'], fg=COLORS['error'])
        self.status_label.pack(pady=10)

    def login(self):
        username = self.username_entry.get()
        password = self.password_entry.get()
        if username == "admin" and password == "admin":
            self.root.destroy()
            main_app = MainApplication()
            main_app.run()
        else:
            self.status_label.config(text="⚠️ ACCESS DENIED - INVALID CREDENTIALS", fg=COLORS['error'])
            self.password_entry.delete(0, tk.END)

    def run(self):
        self.root.mainloop()


