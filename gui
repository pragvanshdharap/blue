        self.disk_label = tk.Label(info_frame, text="STORAGE: --", font=("Consolas", 9),
                                   bg=COLORS['bg_light'], fg=COLORS['text_light'])
        self.disk_label.pack(anchor=tk.W)
        tk.Label(info_frame, text="FAULT SUMMARY:", font=("Consolas", 10, "bold"),
                 bg=COLORS['bg_light'], fg=COLORS['error']).pack(pady=(15, 5))
        self.fault_summary = tk.Label(info_frame, text="", font=("Consolas", 9),
                                      bg=COLORS['bg_light'], fg=COLORS['text_light'])
        self.fault_summary.pack(anchor=tk.W)

    def create_status_display(self, parent):
        """Creates the scrolling text widget for system status messages."""
        self.status_text = tk.Text(parent, height=8, wrap=tk.WORD,
                                   bg=COLORS['bg_light'], fg=COLORS['text_light'],
                                   font=("Consolas", 9), insertbackground=COLORS['text_light'])
        status_scroll = tk.Scrollbar(parent, orient=tk.VERTICAL, command=self.status_text.yview)
        self.status_text.configure(yscrollcommand=status_scroll.set)
        self.status_text.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=5, pady=5)
        status_scroll.pack(side=tk.RIGHT, fill=tk.Y, pady=5)
        self.add_status("🔋 System monitoring initiated")
        self.add_status("✅ All primary systems operational")
        self.add_status("🛡️ Security protocols active")

    def add_status(self, message):
        """Adds a new status message to the status display."""
        timestamp = datetime.now().strftime("%H:%M:%S")
        status_msg = f"[{timestamp}] {message}\n"
        self.status_text.insert(tk.END, status_msg)
        self.status_text.see(tk.END)

    def show_frame(self, frame_class):
        """Destroys the current frame and creates a new one."""
        if self.current_frame:
            self.current_frame.destroy()
        if frame_class == FaultMonitorFrame:
            new_frame = frame_class(self.content_container, self)
        else:
            new_frame = frame_class(self.content_container, self)
        self.current_frame = new_frame
        self.current_frame.pack(fill=tk.BOTH, expand=True)

    def show_hierarchy_frame(self, title, data):
        """Shows the hierarchy details frame with specific data."""
        if self.current_frame:
            self.current_frame.destroy()
        new_frame = HierarchyFrame(self.content_container, self, title, data)
        self.current_frame = new_frame
        self.current_frame.pack(fill=tk.BOTH, expand=True)

    def start_monitoring(self):
        """Starts the background monitoring and time update threads."""
        monitor_thread = threading.Thread(target=self.monitor_system, daemon=True)
        monitor_thread.start()
        self.update_time()

    def monitor_system(self):
        """Monitors system performance and generates occasional faults/status messages."""
        while self.monitoring:
            try:
                cpu_percent = psutil.cpu_percent(interval=1)
                memory = psutil.virtual_memory()
                disk = psutil.disk_usage('/')
                self.root.after(0, self.update_system_stats, cpu_percent, memory, disk)
                if random.randint(1, 50) == 1:
                    fault_types = [
                        ("NETWORK", "Connection timeout on port 8080", "HIGH"),
                        ("SECURITY", "Suspicious login attempt detected", "CRITICAL"),
                        ("STORAGE", "Backup process failed", "MEDIUM"),
                        ("CPU", "Process consuming excessive resources", "HIGH"),
                        ("MEMORY", "Memory usage threshold exceeded", "MEDIUM"),
                        ("SENSOR", "Temperature sensor malfunction", "LOW")
                    ]
                    component, desc, severity = random.choice(fault_types)
                    self.fault_data.add_fault(component, desc, severity)
                    self.root.after(0, self.update_fault_summary)
                    if self.fault_monitor_update_hook:
                        self.root.after(0, self.fault_monitor_update_hook)

                if self.fault_data.active_faults and random.randint(1, 20) == 1:
                    fault_to_resolve = random.choice(self.fault_data.active_faults)
                    self.fault_data.resolve_fault(fault_to_resolve['id'])
                    self.root.after(0, self.add_status,
                                    f"✅ Fault {fault_to_resolve['id']} resolved: {fault_to_resolve['description']}")
                    self.root.after(0, self.update_fault_summary)
                    if self.fault_monitor_update_hook:
                        self.root.after(0, self.fault_monitor_update_hook)

                if random.randint(1, 15) == 1:
                    messages = [
                        "🔍 System health check completed",
                        "🧹 Memory optimization in progress",
                        "🌐 Network connection stable",
                        "🛡️ Security scan completed",
                        "💾 Backup process running",
                        "🗄️ Database maintenance completed",
                        "📊 Performance metrics updated",
                        "⚡ Power systems nominal",
                        "🔧 Scheduled maintenance executed",
                        "📡 Communications link established"
                    ]
                    self.root.after(0, self.add_status, random.choice(messages))
                time.sleep(3)
            except Exception as e:
                self.root.after(0, self.add_status, f"⚠️ Monitoring error: {str(e)}")
                time.sleep(5)

    def update_system_stats(self, cpu_percent, memory, disk):
        """Updates the system metrics display."""
        cpu_color = COLORS['error'] if cpu_percent > 80 else COLORS['warning'] if cpu_percent > 60 else COLORS['success']
        mem_color = COLORS['error'] if memory.percent > 80 else COLORS['warning'] if memory.percent > 60 else COLORS['success']
        disk_color = COLORS['error'] if disk.percent > 80 else COLORS['warning'] if disk.percent > 60 else COLORS['success']
        self.cpu_label.config(text=f"CPU: {cpu_percent:.1f}%", fg=cpu_color)
        self.memory_label.config(text=f"MEMORY: {memory.percent:.1f}%", fg=mem_color)
        self.disk_label.config(text=f"STORAGE: {disk.percent:.1f}%", fg=disk_color)
        self.update_fault_summary()

    def update_fault_summary(self):
        """Updates the fault summary text based on active faults."""
        active_count = len(self.fault_data.active_faults)
        critical_count = sum(1 for f in self.fault_data.active_faults if f['severity'] == 'CRITICAL')
        if active_count == 0:
            self.fault_summary.config(text="✅ NO ACTIVE FAULTS", fg=COLORS['success'])
        else:
            summary_text = f"🚨 {active_count} ACTIVE"
            if critical_count > 0:
                summary_text += f" ({critical_count} CRITICAL)"
            fault_color = COLORS['critical'] if critical_count > 0 else COLORS['warning']
            self.fault_summary.config(text=summary_text, fg=fault_color)

    def update_time(self):
        """Updates the current time display."""
        current_time = datetime.now().strftime("%Y-%m-%d\n%H:%M:%S")
        self.time_label.config(text=current_time)
        self.root.after(1000, self.update_time)

    def logout(self):
        """Handles the application logout process."""
        result = messagebox.askyesno("LOGOUT CONFIRMATION",
                                     "⚠️ TERMINATE CURRENT SESSION?\n\nAll monitoring will be stopped.")
        if result:
            self.monitoring = False
            self.root.destroy()
            login_app = LoginWindow()
            login_app.run()

    def run(self):
        """Starts the main application loop."""
        self.root.protocol("WM_DELETE_WINDOW", self.on_closing)
        self.root.mainloop()

    def on_closing(self):
        """Stops monitoring and closes the window."""
        self.monitoring = False
        self.root.destroy()

if __name__ == "__main__":
    try:
        login_app = LoginWindow()
        login_app.run()
    except Exception as e:
        messagebox.showerror("System Error", f"Critical system failure:\n{str(e)}")