                                                                                                    padx=5)
        tk.Button(btn_frame, text="✅ RESOLVE SELECTED", command=self.resolve_selected,
                  font=("Consolas", 10, "bold"), bg=COLORS['success'], fg=COLORS['text_light']).pack(side=tk.LEFT,
                                                                                                     padx=5)
        # Link back to MainApplication's update method
        self.controller.fault_monitor_update_hook = self.update_fault_display

    def update_fault_display(self):
        """Refreshes the fault display tables."""
        for item in self.active_tree.get_children():
            self.active_tree.delete(item)
        for item in self.history_tree.get_children():
            self.history_tree.delete(item)
        for fault in self.fault_data.active_faults:
            self.active_tree.insert('', 'end', values=(
                fault['id'],
                fault['component'],
                fault['description'],
                fault['severity'],
                fault['timestamp'].strftime('%H:%M:%S')
            ))
        for fault in self.fault_data.fault_history:
            self.history_tree.insert('', 'end', values=(
                fault['id'],
                fault['component'],
                fault['description'],
                fault['severity'],
                fault['timestamp'].strftime('%H:%M:%S'),
                fault['resolved_time'].strftime('%H:%M:%S') if 'resolved_time' in fault else 'N/A'
            ))

    def resolve_selected(self):
        """Resolves a selected fault from the active list."""
        selected = self.active_tree.selection()
        if selected:
            item = self.active_tree.item(selected[0])
            fault_id = int(item['values'][0])
            self.fault_data.resolve_fault(fault_id)
            self.update_fault_display()
            self.controller.update_fault_summary()


