# =========================
# Fault model
# =========================
class FaultData:
    def __init__(self):
        self.active_faults = []
        self.fault_history = []
        self.fault_id_counter = 1

    def add_fault(self, component, description, severity):
        fault = {
            'id': self.fault_id_counter,
            'component': component,
            'description': description,
            'severity': severity,
            'timestamp': datetime.now(),
            'status': 'ACTIVE'
        }
        self.active_faults.append(fault)
        self.fault_id_counter += 1
        return fault

    def resolve_fault(self, fault_id):
        for fault in list(self.active_faults):
            if fault['id'] == fault_id:
                fault['status'] = 'RESOLVED'
                fault['resolved_time'] = datetime.now()
                self.fault_history.append(fault)
                self.active_faults.remove(fault)
                break


