class BasePage(tk.Frame):
    """Generic right-side page with a text console."""
    def __init__(self, parent, title):
        super().__init__(parent, bg=COLORS['bg_dark'])
        tk.Label(self, text=f"{title} COMMAND CENTER",
                 font=("Consolas", 16, "bold"),
                 bg=COLORS['bg_dark'], fg=COLORS['text_light']).pack(pady=12)

        self.status_text = tk.Text(self, height=20, bg=COLORS['bg_light'],
                                   fg=COLORS['text_light'], font=("Consolas", 10),
                                   insertbackground=COLORS['text_light'], wrap="word")
        self.status_text.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

        self.add_log(f"{title} module initialized")
        self.add_log("All systems operational")
        self.add_log("Awaiting commands...")

    def add_log(self, msg):
        timestamp = datetime.now().strftime('%H:%M:%S')
        self.status_text.insert(tk.END, f"[{timestamp}] {msg}\n")
        self.status_text.see(tk.END)


class DetailsPage(tk.Frame):
    """Shown when hierarchy items are clicked; displays details for that component."""
    def __init__(self, parent, title, data):
        super().__init__(parent, bg=COLORS['bg_dark'])
        tk.Label(self, text=f"🎯 {title} DETAILS",
                 font=("Consolas", 16, "bold"),
                 bg=COLORS['bg_dark'], fg=COLORS['text_light']).pack(pady=12)

        wrap = tk.Frame(self, bg=COLORS['bg_dark'])
        wrap.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

        info = tk.Text(wrap, bg=COLORS['bg_medium'], fg=COLORS['text_light'],
                       font=("Consolas", 11), height=20, wrap="word",
                       insertbackground=COLORS['text_light'])
        info.pack(fill=tk.BOTH, expand=True)

        info.insert(tk.END, f"COMPONENT: {title}\n")
        info.insert(tk.END, f"STATUS: OPERATIONAL\n")
        info.insert(tk.END, f"LAST CHECKED: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
        info.insert(tk.END, "=" * 50 + "\n\n")
        if isinstance(data, dict):
            for k, v in data.items():
                info.insert(tk.END, f"{k.upper()}: {v}\n")
        else:
            info.insert(tk.END, f"DETAILS: {data}\n")


class FaultPage(tk.Frame):
    """Full-featured fault monitor in the right pane."""
    def __init__(self, parent, fault_data: FaultData):
        super().__init__(parent, bg=COLORS['bg_dark'])
        self.fault_data = fault_data

        tk.Label(self, text="🚨 SYSTEM FAULT MONITORING 🚨",
                 font=("Consolas", 18, "bold"),
                 bg=COLORS['bg_dark'], fg=COLORS['error']).pack(pady=8)

        container = tk.Frame(self, bg=COLORS['bg_dark'])
        container.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

        # Active faults
        active_frame = tk.LabelFrame(container, text="🔴 ACTIVE FAULTS",
                                     font=("Consolas", 12, "bold"),
                                     bg=COLORS['bg_medium'], fg=COLORS['error'])
        active_frame.pack(fill=tk.BOTH, expand=True, pady=(0, 6))

        self.active_tree = ttk.Treeview(active_frame,
                                        columns=('ID', 'Component', 'Description', 'Severity', 'Time'),
                                        show='headings', height=8)
        for c in ('ID', 'Component', 'Description', 'Severity', 'Time'):
            self.active_tree.heading(c, text=c.upper())
        self.active_tree.column('ID', width=60, anchor="center")
        self.active_tree.column('Component', width=130)
        self.active_tree.column('Description', width=320)
        self.active_tree.column('Severity', width=110, anchor="center")
        self.active_tree.column('Time', width=120, anchor="center")
        self.active_tree.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)

        # History
        history_frame = tk.LabelFrame(container, text="📜 FAULT HISTORY",
                                      font=("Consolas", 12, "bold"),
                                      bg=COLORS['bg_medium'], fg=COLORS['text_light'])
        history_frame.pack(fill=tk.BOTH, expand=True, pady=(6, 0))

        self.history_tree = ttk.Treeview(history_frame,
                                         columns=('ID', 'Component', 'Description', 'Severity', 'Time', 'Resolved'),
                                         show='headings', height=8)
        for c in ('ID', 'Component', 'Description', 'Severity', 'Time', 'Resolved'):
            self.history_tree.heading(c, text=c.upper())
        self.history_tree.column('ID', width=60, anchor="center")
        self.history_tree.column('Component', width=120)
        self.history_tree.column('Description', width=280)
        self.history_tree.column('Severity', width=110, anchor="center")
        self.history_tree.column('Time', width=120, anchor="center")
        self.history_tree.column('Resolved', width=120, anchor="center")
        self.history_tree.pack(fill=tk.BOTH, expand=True, padx=5, pady=5)

        # Controls
        btns = tk.Frame(self, bg=COLORS['bg_dark'])
        btns.pack(pady=6)
        tk.Button(btns, text="🔄 REFRESH", command=self.update_fault_display,
                  font=("Consolas", 10, "bold"), bg=COLORS['accent'],
                  fg=COLORS['text_light']).pack(side=tk.LEFT, padx=5)
        tk.Button(btns, text="✅ RESOLVE SELECTED", command=self.resolve_selected,
                  font=("Consolas", 10, "bold"), bg=COLORS['success'],
                  fg=COLORS['text_light']).pack(side=tk.LEFT, padx=5)

        self.update_fault_display()

    def update_fault_display(self):
        for item in self.active_tree.get_children():
            self.active_tree.delete(item)
        for item in self.history_tree.get_children():
            self.history_tree.delete(item)

        for f in self.fault_data.active_faults:
            self.active_tree.insert('', 'end', values=(
                f['id'], f['component'], f['description'],
                f['severity'], f['timestamp'].strftime('%H:%M:%S')
            ))
        for f in self.fault_data.fault_history:
            self.history_tree.insert('', 'end', values=(
                f['id'], f['component'], f['description'],
                f['severity'], f['timestamp'].strftime('%H:%M:%S'),
                f['resolved_time'].strftime('%H:%M:%S') if 'resolved_time' in f else 'N/A'
            ))

    def resolve_selected(self):
        sel = self.active_tree.selection()
        if sel:
            item = self.active_tree.item(sel[0])
            fault_id = int(item['values'][0])
            self.fault_data.resolve_fault(fault_id)
            self.update_fault_display()


