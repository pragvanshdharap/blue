    # ----- Page control -----
    def show_page(self, name):
        """Show a page based on the name - either from top buttons or hierarchy"""
        if self.current_page:
            self.current_page.destroy()

        if name == "FAULT":
            self.current_page = FaultPage(self.page_container, self.fault_data)
        else:
            self.current_page = BasePage(self.page_container, name)

        self.current_page.pack(fill=tk.BOTH, expand=True)

    def show_hierarchy_details(self, title, data):
        """Show a details page in the right-side container when a hierarchy item is clicked."""
        if self.current_page:
            self.current_page.destroy()
        self.current_page = DetailsPage(self.page_container, title, data)
        self.current_page.pack(fill=tk.BOTH, expand=True)

    # ----- Status & metrics -----
    def add_status(self, message):
        timestamp = datetime.now().strftime("%H:%M:%S")
        self.status_text.insert(tk.END, f"[{timestamp}] {message}\n")
        self.status_text.see(tk.END)

    def update_time(self):
        self.time_label.config(text=datetime.now().strftime("%Y-%m-%d\n%H:%M:%S"))
        self.root.after(1000, self.update_time)

    def update_system_stats_labels(self, cpu_percent, memory, disk):
        # Colors based on thresholds
        cpu_c = COLORS['error'] if cpu_percent > 80 else COLORS['warning'] if cpu_percent > 60 else COLORS['success']
        mem_c = COLORS['error'] if memory.percent > 80 else COLORS['warning'] if memory.percent > 60 else COLORS['success']
        dsk_c = COLORS['error'] if disk.percent > 80 else COLORS['warning'] if disk.percent > 60 else COLORS['success']

        self.cpu_label.config(text=f"CPU: {cpu_percent:.1f}%", fg=cpu_c)
        self.memory_label.config(text=f"MEMORY: {memory.percent:.1f}%", fg=mem_c)
        self.disk_label.config(text=f"STORAGE: {disk.percent:.1f}%", fg=dsk_c)

        # Fault summary
        active_count = len(self.fault_data.active_faults)
        critical_count = sum(1 for f in self.fault_data.active_faults if f['severity'] == 'CRITICAL')
        if active_count == 0:
            self.fault_summary.config(text="✅ NO ACTIVE FAULTS", fg=COLORS['success'])
        else:
            txt = f"🚨 {active_count} ACTIVE"
            if critical_count > 0:
                txt += f" ({critical_count} CRITICAL)"
            col = COLORS['critical'] if critical_count > 0 else COLORS['warning']
            self.fault_summary.config(text=txt, fg=col)

        # If we're on the fault page, keep it fresh
        if isinstance(self.current_page, FaultPage):
            self.current_page.update_fault_display()

    # ----- Monitoring loop -----
    def start_monitoring(self):
        t = threading.Thread(target=self.monitor_system, daemon=True)
        t.start()

    def monitor_system(self):
        while self.monitoring:
            try:
                # Pull system stats
                cpu_percent = psutil.cpu_percent(interval=1)
                memory = psutil.virtual_memory()
                disk = psutil.disk_usage('/')

                # Post updates to UI
                self.root.after(0, self.update_system_stats_labels, cpu_percent, memory, disk)

                # Randomly create faults
                if random.randint(1, 50) == 1:  # ~2%
                    fault_types = [
                        ("NETWORK", "Connection timeout on port 8080", "HIGH"),
                        ("SECURITY", "Suspicious login attempt detected", "CRITICAL"),
                        ("STORAGE", "Backup process failed", "MEDIUM"),
                        ("CPU", "Process consuming excessive resources", "HIGH"),
                        ("MEMORY", "Memory usage threshold exceeded", "MEDIUM"),
                        ("SENSOR", "Temperature sensor malfunction", "LOW")
                    ]
                    comp, desc, sev = random.choice(fault_types)
                    self.fault_data.add_fault(comp, desc, sev)
                    self.root.after(0, self.add_status, f"🚨 New fault: {comp} – {desc} [{sev}]")

                # Randomly resolve a fault
                if self.fault_data.active_faults and random.randint(1, 20) == 1:  # ~5%
                    to_resolve = random.choice(self.fault_data.active_faults)
                    self.fault_data.resolve_fault(to_resolve['id'])
                    self.root.after(0, self.add_status,
                                    f"✅ Fault {to_resolve['id']} resolved: {to_resolve['description']}")

                # Random status noise
                if random.randint(1, 15) == 1:
                    self.root.after(0, self.add_status, random.choice([
                        "🔍 System health check completed",
                        "🧹 Memory optimization in progress",
                        "🌐 Network connection stable",
                        "🛡️ Security scan completed",
                        "💾 Backup process running",
                        "🗄️ Database maintenance completed",
                        "📊 Performance metrics updated",
                        "⚡ Power systems nominal",
                        "🔧 Scheduled maintenance executed",
                        "📡 Communications link established"
                    ]))

                time.sleep(2)
