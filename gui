                "🌍 WEB SERVER": "HTTP/HTTPS web services",
                "🗄️ DATABASE": "Data storage and retrieval systems",
                "📁 FILE SYSTEM": "File management and permissions",
                "📧 MAIL SERVER": "Email services and protocols"
            },
