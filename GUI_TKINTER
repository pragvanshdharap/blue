        # Bottom spacer and footer
        tk.Frame(content_frame, bg='#3a3d40', height=40).pack()

        footer_label = tk.Label(content_frame, text="SYSTEM v2.1.7 | SECURE TERMINAL",
                                font=('Courier New', 10),
                                fg='#666', bg='#3a3d40')
        footer_label.pack(side='bottom')

    def authenticate(self):
        username = self.username_entry.get().strip()
        password = self.password_entry.get().strip()

        if not username or not password:
            self.show_status("ERROR: INCOMPLETE CREDENTIALS", "#ff5722")
            return

        if username.lower() == "admin" and password == "password":
            self.show_status("ACCESS GRANTED", "#4caf50")
            self.root.after(1000, self._login_success)
        else:
            self.show_status("ACCESS DENIED: INVALID CREDENTIALS", "#ff5722")
            self.password_entry.delete(0, tk.END)

    def _login_success(self):
        self.root.destroy()
        self.on_login_success()

    def show_status(self, message, color):
        self.status_label.config(text=message, fg=color,
                                 bg='#4a4d50')


