        security_label = tk.Label(content_frame, text="● SECURITY LEVEL: CLASSIFIED",
                                  font=('Courier New', 10, 'bold'),
                                  fg='#ff5722', bg='#3a3d40')
        security_label.pack(pady=(5, 30))

        # Form section
