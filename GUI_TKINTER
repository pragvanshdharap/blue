class MilitaryApplication:
    def __init__(self):
        self.main_window = None

    def show_login(self):
        # Create a hidden root window
        self.root = tk.Tk()
        self.root.withdraw()  # Hide the main root window

        # Show login window
        login_window = MilitaryLoginWindow(self.on_login_success)
        self.root.wait_window(login_window.root)

    def on_login_success(self):
        # Create and show main window
        self.main_window = MilitaryMainWindow()
        self.root.deiconify()  # Show root window
        self.root.withdraw()  # Hide it again
        self.main_window.root.mainloop()

    def run(self):
        self.show_login()


def main():
    app = MilitaryApplication()
    app.run()


if __name__ == "__main__":
    main()
