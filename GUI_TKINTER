import tkinter as tk
from tkinter import ttk, messagebox
import random

# -------------------------------
# Login Window
# -------------------------------
class MilitaryLoginWindow(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("LOGIN WINDOW")
        self.geometry("450x600")
        self.configure(bg="#2b2d2f")
        self.resizable(False, False)

        self.create_login_frame()
        self.center_window()

    def create_login_frame(self):
        frame = tk.Frame(self, bg="#3a3d40", bd=2, relief="solid", highlightbackground="#5a6b3b")
        frame.place(relx=0.5, rely=0.5, anchor="center", width=400, height=500)

        # Title
        title = tk.Label(frame, text="CLASSIFIED ACCESS", fg="#9ccc65", bg="#3a3d40",
                         font=("Courier New", 20, "bold"))
        title.pack(pady=(20, 5))

        subtitle = tk.Label(frame, text="AUTHORIZED PERSONNEL ONLY", fg="#ffcc02", bg="#3a3d40",
                            font=("Courier New", 10, "bold"))
        subtitle.pack()

        security = tk.Label(frame, text="● SECURITY LEVEL: CLASSIFIED", fg="#ff5722", bg="#3a3d40",
                            font=("Courier New", 9, "bold"))
        security.pack(pady=(10, 20))

        # Username
        tk.Label(frame, text="USERNAME:", fg="#c5c8c6", bg="#3a3d40",
                 font=("Courier New", 11, "bold")).pack(anchor="w", padx=30)
        self.username_entry = tk.Entry(frame, bg="#1e1e1e", fg="#9ccc65",
                                       font=("Courier New", 12), insertbackground="white")
        self.username_entry.pack(pady=5, padx=30, fill="x")

        # Password
        tk.Label(frame, text="PASSWORD:", fg="#c5c8c6", bg="#3a3d40",
                 font=("Courier New", 11, "bold")).pack(anchor="w", padx=30, pady=(10, 0))
        self.password_entry = tk.Entry(frame, show="*", bg="#1e1e1e", fg="#9ccc65",
                                       font=("Courier New", 12), insertbackground="white")
        self.password_entry.pack(pady=5, padx=30, fill="x")

        # Status
        self.status_label = tk.Label(frame, text="", bg="#3a3d40", font=("Courier New", 10, "bold"))
        self.status_label.pack(pady=10)

        # Buttons
        tk.Button(frame, text="AUTHENTICATE", bg="#556b2f", fg="white",
                  font=("Courier New", 12, "bold"), command=self.authenticate).pack(pady=5, fill="x", padx=50)
        tk.Button(frame, text="ABORT", bg="#654321", fg="white",
                  font=("Courier New", 12, "bold"), command=self.quit).pack(pady=5, fill="x", padx=50)

        footer = tk.Label(frame, text="SYSTEM v2.1.7 | SECURE TERMINAL", fg="#666", bg="#3a3d40",
                          font=("Courier New", 9))
        footer.pack(side="bottom", pady=10)

    def center_window(self):
        self.update_idletasks()
        w = self.winfo_width()
        h = self.winfo_height()
        sw = self.winfo_screenwidth()
        sh = self.winfo_screenheight()
        x = (sw - w) // 2
        y = (sh - h) // 2
        self.geometry(f"{w}x{h}+{x}+{y}")

    def authenticate(self):
        user = self.username_entry.get().strip()
        pwd = self.password_entry.get().strip()

        if not user or not pwd:
            self.show_status("ERROR: INCOMPLETE CREDENTIALS", "red")
            return

        if user.lower() == "admin" and pwd == "password":
            self.show_status("ACCESS GRANTED", "green")
            self.after(1000, self.open_main_window)
        else:
            self.show_status("ACCESS DENIED: INVALID CREDENTIALS", "red")
            self.password_entry.delete(0, tk.END)

    def show_status(self, msg, color):
        self.status_label.config(text=msg, fg=color)

    def open_main_window(self):
        self.destroy()
        app = MilitaryMainWindow()
        app.mainloop()


# -------------------------------
# Main Window
# -------------------------------
class MilitaryMainWindow(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("SHM")
        self.geometry("1200x800")
        self.configure(bg="#1e2124")

        self.create_top_buttons()
        self.create_tree_section()
        self.create_status_bar()

        self.update_system_status()

    def create_top_buttons(self):
        frame = tk.Frame(self, bg="#36393f", bd=2, relief="solid", highlightbackground="#5a6b3b")
        frame.pack(fill="x", pady=10)

        buttons = ["HOME", "SENSORS", "STM", "RASPBERRY PI", "SETTINGS"]
        for b in buttons:
            tk.Button(frame, text=b, bg="#4f545c", fg="white", font=("Arial", 12, "bold"),
                      command=lambda name=b: self.handle_button_click(name)).pack(side="left", padx=10, pady=10)

    def create_tree_section(self):
        frame = tk.Frame(self, bg="#2f3136", bd=2, relief="solid", highlightbackground="#5a6b3b")
        frame.pack(fill="both", expand=True, padx=10, pady=10)

        title = tk.Label(frame, text="ATAGS STRUCTURE HIERARCHY", fg="#9ccc65", bg="#2f3136",
                         font=("Courier New", 16, "bold"))
        title.pack(pady=5)

        self.tree = ttk.Treeview(frame)
        self.tree.pack(fill="both", expand=True, padx=20, pady=10)

        # Example hierarchy (abbreviated, add full like in PyQt)
        root = self.tree.insert("", "end", text="ATAGS", open=True)
        upper = self.tree.insert(root, "end", text="UPPER CARRIAGE", open=True)
        self.tree.insert(upper, "end", text="CRADDLE ASSEMBLY")
        self.tree.insert(upper, "end", text="ORDANANCE & RECOIL")
        self.tree.insert(root, "end", text="UNDER CARRIAGE", open=True)

    def create_status_bar(self):
        frame = tk.Frame(self, bg="#36393f", bd=2, relief="solid", highlightbackground="#5a6b3b")
        frame.pack(fill="x", side="bottom", pady=10)

        tk.Label(frame, text="SYSTEM STATUS MONITOR", fg="#9ccc65", bg="#36393f",
                 font=("Courier New", 12, "bold")).pack(pady=5)

        self.cpu = self.make_bar(frame, "CPU")
        self.mem = self.make_bar(frame, "MEMORY")
        self.net = self.make_bar(frame, "NETWORK")
        self.sec = self.make_bar(frame, "SECURITY")

        self.overall = tk.Label(frame, text="ALL SYSTEMS OPERATIONAL", fg="green", bg="#36393f",
                                font=("Courier New", 10, "bold"))
        self.overall.pack(pady=5)

    def make_bar(self, parent, name):
        row = tk.Frame(parent, bg="#36393f")
        row.pack(fill="x", padx=20, pady=2)
        tk.Label(row, text=name, fg="white", bg="#36393f",
                 font=("Courier New", 10, "bold")).pack(side="left")
        bar = ttk.Progressbar(row, orient="horizontal", mode="determinate", length=200)
        bar.pack(side="left", padx=10)
        return bar

    def update_system_status(self):
        cpu = random.randint(15, 85)
        mem = random.randint(30, 75)
        net = random.randint(60, 100)
        sec = random.randint(85, 100)

        self.cpu["value"] = cpu
        self.mem["value"] = mem
        self.net["value"] = net
        self.sec["value"] = sec

        avg = (cpu + mem + net + sec) / 4
        if avg >= 80:
            self.overall.config(text="ALL SYSTEMS OPERATIONAL", fg="green")
        elif avg >= 60:
            self.overall.config(text="SYSTEMS NOMINAL - MINOR ISSUES", fg="yellow")
        else:
            self.overall.config(text="WARNING - SYSTEM DEGRADATION", fg="red")

        self.after(2000, self.update_system_status)

    def handle_button_click(self, name):
        messagebox.showinfo("Button Clicked", f"You clicked {name}")


# -------------------------------
# Run App
# -------------------------------
if __name__ == "__main__":
    login = MilitaryLoginWindow()
    login.mainloop()
