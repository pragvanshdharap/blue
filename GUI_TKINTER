        # Password
        tk.Label(form_frame, text="PASSWORD:", font=('Courier New', 12, 'bold'),
                 fg='#c5c8c6', bg='#3a3d40').pack(anchor='w', pady=(0, 5))

        self.password_entry = tk.Entry(form_frame, font=('Courier New', 14),
                                       bg='#1e1e1e', fg='#9ccc65',
                                       insertbackground='#9ccc65',
                                       bd=2, relief='solid',
                                       highlightcolor='#9ccc65',
                                       highlightthickness=2,
                                       show='*')
        self.password_entry.pack(fill='x', ipady=8, pady=(0, 20))

        # Buttons
        login_btn = tk.Button(form_frame, text="AUTHENTICATE",
                              font=('Courier New', 14, 'bold'),
                              bg='#6b8e23', fg='white',
                              activebackground='#7ba428',
                              activeforeground='white',
                              bd=2, relief='raised',
                              command=self.authenticate)
        login_btn.pack(fill='x', ipady=10, pady=(0, 10))

        cancel_btn = tk.Button(form_frame, text="ABORT",
                               font=('Courier New', 12, 'bold'),
                               bg='#8b4513', fg='white',
                               activebackground='#a0522d',
                               activeforeground='white',
                               bd=2, relief='raised',
                               command=self.root.destroy)
        cancel_btn.pack(fill='x', ipady=8, pady=(0, 20))

        # Status label
        self.status_label = tk.Label(form_frame, text="",
                                     font=('Courier New', 11, 'bold'),
