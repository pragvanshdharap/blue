class MilitaryMainWindow(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("SHM")
        self.geometry("1200x800")
        self.configure(bg="#1e2124")

        self.create_top_buttons()
        self.create_tree_section()
        self.create_status_bar()

        self.update_system_status()

    def create_top_buttons(self):
        frame = tk.Frame(self, bg="#36393f", bd=2, relief="solid", highlightbackground="#5a6b3b")
        frame.pack(fill="x", pady=10)

        buttons = ["HOME", "SENSORS", "STM", "RASPBERRY PI", "SETTINGS"]
        for b in buttons:
            tk.Button(frame, text=b, bg="#4f545c", fg="white", font=("Arial", 12, "bold"),
                      command=lambda name=b: self.handle_button_click(name)).pack(side="left", padx=10, pady=10)

    def create_tree_section(self):
        frame = tk.Frame(self, bg="#2f3136", bd=2, relief="solid", highlightbackground="#5a6b3b")
        frame.pack(fill="both", expand=True, padx=10, pady=10)

        title = tk.Label(frame, text="ATAGS STRUCTURE HIERARCHY", fg="#9ccc65", bg="#2f3136",
                         font=("Courier New", 16, "bold"))
        title.pack(pady=5)

        self.tree = ttk.Treeview(frame)
        self.tree.pack(fill="both", expand=True, padx=20, pady=10)

        # Example hierarchy (abbreviated, add full like in PyQt)
        root = self.tree.insert("", "end", text="ATAGS", open=True)
        upper = self.tree.insert(root, "end", text="UPPER CARRIAGE", open=True)
        self.tree.insert(upper, "end", text="CRADDLE ASSEMBLY")
        self.tree.insert(upper, "end", text="ORDANANCE & RECOIL")
        self.tree.insert(root, "end", text="UNDER CARRIAGE", open=True)

    def create_status_bar(self):
        frame = tk.Frame(self, bg="#36393f", bd=2, relief="solid", highlightbackground="#5a6b3b")
        frame.pack(fill="x", side="bottom", pady=10)

        tk.Label(frame, text="SYSTEM STATUS MONITOR", fg="#9ccc65", bg="#36393f",
                 font=("Courier New", 12, "bold")).pack(pady=5)

        self.cpu = self.make_bar(frame, "CPU")
        self.mem = self.make_bar(frame, "MEMORY")
        self.net = self.make_bar(frame, "NETWORK")
        self.sec = self.make_bar(frame, "SECURITY")

        self.overall = tk.Label(frame, text="ALL SYSTEMS OPERATIONAL", fg="green", bg="#36393f",
                                font=("Courier New", 10, "bold"))
        self.overall.pack(pady=5)

    def make_bar(self, parent, name):
        row = tk.Frame(parent, bg="#36393f")
        row.pack(fill="x", padx=20, pady=2)
        tk.Label(row, text=name, fg="white", bg="#36393f",
                 font=("Courier New", 10, "bold")).pack(side="left")
        bar = ttk.Progressbar(row, orient="horizontal", mode="determinate", length=200)
        bar.pack(side="left", padx=10)
        return bar

    def update_system_status(self):
        cpu = random.randint(15, 85)
        mem = random.randint(30, 75)
        net = random.randint(60, 100)
        sec = random.randint(85, 100)

        self.cpu["value"] = cpu
        self.mem["value"] = mem
        self.net["value"] = net
        self.sec["value"] = sec

        avg = (cpu + mem + net + sec) / 4
        if avg >= 80:
            self.overall.config(text="ALL SYSTEMS OPERATIONAL", fg="green")
        elif avg >= 60:
            self.overall.config(text="SYSTEMS NOMINAL - MINOR ISSUES", fg="yellow")
        else:
            self.overall.config(text="WARNING - SYSTEM DEGRADATION", fg="red")

        self.after(2000, self.update_system_status)

    def handle_button_click(self, name):
        messagebox.showinfo("Button Clicked", f"You clicked {name}")


# -------------------------------
# Run App
# -------------------------------
if __name__ == "__main__":
    login = MilitaryLoginWindow()
    login.mainloop()





