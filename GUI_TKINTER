    def start_monitoring(self):
        def update_status():
            while True:
                try:
                    # Generate random values
                    cpu_val = random.randint(15, 85)
                    mem_val = random.randint(30, 75)
                    net_val = random.randint(60, 100)
                    sec_val = random.randint(85, 100)

                    # Update progress bars
                    self.root.after(0, lambda val=cpu_val: self.cpu_var.set(val))
                    self.root.after(0, lambda val=mem_val: self.mem_var.set(val))
                    self.root.after(0, lambda val=net_val: self.net_var.set(val))
                    self.root.after(0, lambda val=sec_val: self.sec_var.set(val))

                    # Update overall status
                    avg_health = (cpu_val + mem_val + net_val + sec_val) / 4

                    if avg_health >= 80:
                        status_text = "ALL SYSTEMS OPERATIONAL"
                        color = "#4caf50"
                    elif avg_health >= 60:
                        status_text = "SYSTEMS NOMINAL - MINOR ISSUES"
                        color = "#ffcc02"
                    else:
                        status_text = "WARNING - SYSTEM DEGRADATION"
                        color = "#ff5722"

                    self.root.after(0, lambda t=status_text, c=color: self.overall_status.config(
                        text=t, fg=c))

                    time.sleep(2)

                except Exception:
                    break

        # Start monitoring thread
        thread = threading.Thread(target=update_status, daemon=True)
        thread.start()

