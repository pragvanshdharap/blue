        # Username
        tk.Label(form_frame, text="USERNAME:", font=('Courier New', 12, 'bold'),
                 fg='#c5c8c6', bg='#3a3d40').pack(anchor='w', pady=(0, 5))

        self.username_entry = tk.Entry(form_frame, font=('Courier New', 14),
