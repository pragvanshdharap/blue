    def _index_of(self, key):
        keys = ['home','sensors','stm','raspberry','faults','settings']
        try: return keys.index(key)
        except ValueError: return 0

    def _goto(self, key, add_history=True):
        if key == self.current_key: return
        if add_history and getattr(self,'current_key',None): self._prev_stack.append(self.current_key)
        index = self._index_of(key); self.stack.setCurrentIndex(index); self.current_key = key; self._update_bottom_buttons()

    def _back(self):
        if self._prev_stack:
            prev = self._prev_stack.pop(); self._goto(prev, add_history=False)
        else:
            QMessageBox.information(self, "Back", "No previous screen in history.")

    def _update_bottom_buttons(self):
        cur_widget = self.stack.currentWidget()
        for child in cur_widget.findChildren(QWidget):
            if getattr(child,'objectName',None) == "bottomBar" or child.objectName()=="bottomBar":
                back_btn = getattr(child, "back_btn", None)
                if back_btn:
                    back_btn.setEnabled(bool(self._prev_stack))
        if self.current_key == 'home':
            cur_widget = self.stack.currentWidget()
            for child in cur_widget.findChildren(QWidget):
                if child.objectName()=="bottomBar":
                    if getattr(child,"home_btn",None): child.home_btn.setEnabled(False)
        else:
            for page in [self.pages[k] for k in self.pages]:
                for child in page.findChildren(QWidget):
                    if child.objectName()=="bottomBar":
                        if getattr(child,"home_btn",None): child.home_btn.setEnabled(True)

    def _on_left_button_clicked(self, screen_name, button_idx):
        cur_widget = self.stack.currentWidget()
        center_layout = getattr(cur_widget, "center_layout", None)
        if center_layout is None:
            QMessageBox.information(self, "Action", f"You pressed {screen_name} -> button{button_idx}")
            return
        while center_layout.count():
            item = center_layout.takeAt(0)
            widget = item.widget()
            if widget:
                widget.setParent(None); widget.deleteLater()
        choice = random.choice(["line","bar","scatter","table","text"])
        if choice in ("line","bar","scatter"):
            canvas = make_plot_canvas(kind=choice)
            center_layout.addWidget(canvas)
