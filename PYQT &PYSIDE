            center_layout.addWidget(table)
        else:
            txt = QLabel(); txt.setWordWrap(True)
            sample = [f"Status report: OK — {random.randint(0,100)} events processed.",
                      f"Latency sample: {random.uniform(0.5,20.0):.2f} ms (avg).",
                      f"Sensor summary: mean={random.uniform(10,50):.2f}, std={random.uniform(0.1,5):.2f}.",
                      "Image preview placeholder (no image loaded)."]
            txt.setText(random.choice(sample)); txt.setAlignment(Qt.AlignCenter); center_layout.addWidget(txt)

    def _on_logout_clicked(self):
