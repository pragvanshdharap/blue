# ---------- Main Window ----------
class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Embedded System GUI")
        self.resize(900, 600)
        self._build_ui()
        self._start_status_timer()

    def _build_ui(self):
        main_widget = QWidget()
        main_layout = QVBoxLayout()

        # --- Top navigation buttons ---
        nav_layout = QHBoxLayout()
        for label in ["Home", "Sensor", "STM", "Raspberry Pi", "Faults", "Settings"]:
            btn = QPushButton(label)
            nav_layout.addWidget(btn)
        main_layout.addLayout(nav_layout)

        # --- Tree Widget ---
        self.tree = QTreeWidget()
        self.tree.setHeaderLabel("System Hierarchy")
        root = QTreeWidgetItem(["System"])
        QTreeWidgetItem(root, ["STM"])
        QTreeWidgetItem(root, ["Raspberry Pi"])
        QTreeWidgetItem(root, ["Sensors"])
        QTreeWidgetItem(root, ["Faults"])
        self.tree.addTopLevelItem(root)
        main_layout.addWidget(self.tree)

        # --- Status Label (Fixed here) ---
        self.status_label = QLabel("System Health: OK ù CPU 0% ù MEM 0%")
        main_layout.addWidget(self.status_label)

        # --- Logout button (kept where it was) ---
        logout_btn = QPushButton("Logout")
        logout_btn.clicked.connect(self._on_logout_clicked)
        main_layout.addWidget(logout_btn)

        # --- Bottom navigation ---
        bottom_layout = QHBoxLayout()
        back_btn = QPushButton("Back")
        home_btn = QPushButton("Home")
        bottom_layout.addWidget(back_btn)
        bottom_layout.addWidget(home_btn)
        main_layout.addLayout(bottom_layout)

        main_widget.setLayout(main_layout)
        self.setCentralWidget(main_widget)

    # --- Logout handler ---
    def _on_logout_clicked(self):
        reply = QMessageBox.question(
            self,
            "Logout",
            "Are you sure you want to logout?",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        if reply == QMessageBox.Yes:
            QApplication.quit()

    # --- System health updater ---
    def _start_status_timer(self):
        self.timer = QTimer(self)
        self.timer.timeout.connect(self._update_status)
        self.timer.start(2000)

    def _update_status(self):
        health = "OK"
        cpu = psutil.cpu_percent()
        mem = psutil.virtual_memory().percent
        self.status_label.setText(f"System Health: {health} ù CPU {cpu:.1f}% ù MEM {mem:.1f}%")

# ---------- Main ----------
def main():
    app = QApplication(sys.argv)
    login = LoginDialog()
    if login.exec_() == QDialog.Accepted:
        user, passwd = login.get_credentials()
        if user == "admin" and passwd == "admin":  # simple check
            win = MainWindow()
            win.show()
            sys.exit(app.exec_())
        else:
            QMessageBox.warning(None, "Login Failed", "Invalid credentials")
    sys.exit()

if __name__ == "__main__":
    main()
