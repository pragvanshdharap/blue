# ---------- Login Dialog ----------
class LoginDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Login - Military GUI")
        self.setFixedSize(380, 220)
        self._build_ui()

    def _build_ui(self):
        layout = QVBoxLayout()
        layout.setContentsMargins(20,18,20,18)
        title = QLabel("Secure Access")
        title.setObjectName("titleLabel")
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)
        form = QFormLayout()
        self.username_edit = QLineEdit(); self.username_edit.setPlaceholderText("Username")
        self.password_edit = QLineEdit(); self.password_edit.setPlaceholderText("Password"); self.password_edit.setEchoMode(QLineEdit.EchoMode.Password)
        form.addRow("Username:", self.username_edit)
        form.addRow("Password:", self.password_edit)
        layout.addLayout(form)
        btn_layout = QHBoxLayout()
        btn_layout.addStretch()
        login_btn = QPushButton("Login"); login_btn.clicked.connect(self.attempt_login)
        btn_layout.addWidget(login_btn)
        layout.addLayout(btn_layout)
        self.setLayout(layout)

    @Slot()
    def attempt_login(self):
        user = self.username_edit.text().strip(); pwd = self.password_edit.text()
        if (user == "admin" and pwd == "admin123") or (user and pwd):
            self.accept()
        else:
            QMessageBox.warning(self, "Login failed", "Invalid credentials.")

# ---------- plotting / fallback widgets ----------
def make_plot_canvas(kind="line"):
    """Return a widget: either a matplotlib canvas (if available) or a fallback widget with install button."""
    if HAVE_MPL:
        fig = Figure(figsize=(5,3), tight_layout=True)
        ax = fig.add_subplot(111)
        if kind == "line":
            x = list(range(1,21))
            y = [random.uniform(0,1) + 0.5*(i/20) for i in x]
            ax.plot(x,y,marker='o'); ax.set_title("Random Line Data")
        elif kind == "bar":
            labels = [f"C{i}" for i in range(1,7)]; vals = [random.randint(1,30) for _ in labels]
            ax.bar(labels, vals); ax.set_title("Random Bar Data")
        elif kind == "scatter":
            xs = [random.random() for _ in range(50)]; ys=[random.random() for _ in range(50)]
            ax.scatter(xs,ys,alpha=0.7); ax.set_title("Random Scatter")
        canvas = FigureCanvas(fig)
        canvas.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        return canvas
    else:
        # Fallback widget with message + install button
        w = QWidget()
        l = QVBoxLayout(); l.setAlignment(Qt.AlignCenter)
        msg = QLabel("matplotlib not installed.Install to view plots inside the app.")
        msg.setAlignment(Qt.AlignCenter)
        btn = QPushButton("Install matplotlib (requires internet)")
        def run_install():
            btn.setEnabled(False); btn.setText("Installing... (may take a minute)")
            def target():
                try:
                    proc = subprocess.run([sys.executable, "-m", "pip", "install", "matplotlib"], capture_output=True, text=True)
                    ok = proc.returncode == 0
                    # need to inform user to restart if success
                    if ok:
                        QMessageBox.information(w, "Installed", "matplotlib installed successfully. Please restart the application.")
                    else:
                        QMessageBox.critical(w, "Install failed", f"Return code {proc.returncode}{proc.stderr[:1000]}")
                except Exception as e:
                    QMessageBox.critical(w, "Error", str(e))
                finally:
                    btn.setEnabled(True); btn.setText("Install matplotlib (requires internet)")
            threading.Thread(target=target, daemon=True).start()
        btn.clicked.connect(run_install)
        l.addWidget(msg); l.addWidget(btn)
        w.setLayout(l)
        w.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        return w

