    def _fill_sample_active_events(self, table: QTableWidget):
        sample = [("A100","Sensor alert: threshold","High"),("A101","Comm. lost with node 4","Critical"),("A102","Battery low on unit 9","Medium")]
        table.setRowCount(len(sample))
