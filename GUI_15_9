from PySide6 import QtCore, QtWidgets, QtGui
import sys
from datetime import datetime

# -----------------------------
# Military-grade colour palette
# -----------------------------
PALETTE = {
    "bg": "#1C1F1A",            # deep camo black-green
    "topbar": "#2E3B26",        # dark olive drab
    "active": "#556B2F",        # olive drab highlight
    "accent": "#A67B5B",        # earthy tan
    "text": "#E0E0C0",          # desaturated light khaki
    "health_good": "#4B8B3B",   # camo green
    "health_warn": "#D2B55B",   # desert yellow
    "health_bad": "#B22222",    # dark red (alert)
}


# -----------------------------
# Dynamic stylesheet generator
# -----------------------------
def get_dynamic_style(scale: float = 1.0) -> str:
    base_size = int(12 * scale)
    return f"""
    QMainWindow {{ background: {PALETTE['bg']}; color: {PALETTE['text']}; }}
    QWidget {{ background: transparent; color: {PALETTE['text']}; 
               font-family: 'Consolas', 'Courier New', monospace; 
               font-size: {base_size}px; }}
    QPushButton {{
        border-radius: 6px;
        padding: {int(6*scale)}px {int(10*scale)}px;
        background: #2E3B26;
        border: 1px solid #444;
        color: {PALETTE['text']};
    }}
    QPushButton:hover {{ background: {PALETTE['active']}; border: 1px solid {PALETTE['accent']}; 
                         color: black; font-weight: bold; }}
    QPushButton:checked {{ background: {PALETTE['active']}; color: black; font-weight: bold; }}

    QFrame#TopBar {{ background: {PALETTE['topbar']}; padding: {int(6*scale)}px; }}
    QFrame#BottomBar {{ background: #232720; padding: {int(6*scale)}px; }}
    QLabel#Title {{ font-size: {int(18*scale)}px; font-weight: bold; color: {PALETTE['accent']}; }}

    QTreeWidget {{ background: #20241C; border: 1px solid #3a3a3a; 
                   alternate-background-color: #262A22; }}
    QTreeWidget::item {{ height: {int(28*scale)}px; padding: {int(2*scale)}px; }}
    QTableWidget {{ background: #20241C; border: 1px solid #3a3a3a; 
                    alternate-background-color: #262A22; }}

    QLineEdit, QComboBox, QTextEdit {{
        background: #2A2F25; border: 1px solid #555; 
        padding: {int(4*scale)}px; color: {PALETTE['text']};
    }}
    QGroupBox {{ border: 1px solid #444; margin-top: {int(6*scale)}px; 
                font-weight: bold; color: {PALETTE['accent']}; }}
    QHeaderView::section {{ background: #3B422F; color: {PALETTE['text']}; 
                            padding: {int(4*scale)}px; border: 1px solid #444; }}
    """


# =============================
# LOGIN WINDOW
# =============================
class LoginWindow(QtWidgets.QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Login")
        self.setMinimumSize(320, 200)
        self.setSizePolicy(QtWidgets.QSizePolicy.Policy.Expanding,
                           QtWidgets.QSizePolicy.Policy.Expanding)

        layout = QtWidgets.QVBoxLayout(self)

        title = QtWidgets.QLabel("Secure GUI Login")
        title.setObjectName("Title")
        title.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        form = QtWidgets.QFormLayout()
        self.username = QtWidgets.QLineEdit()
        self.password = QtWidgets.QLineEdit()
        self.password.setEchoMode(QtWidgets.QLineEdit.EchoMode.Password)
        form.addRow("Username:", self.username)
        form.addRow("Password:", self.password)
        layout.addLayout(form)

        btn = QtWidgets.QPushButton("Login")
        btn.clicked.connect(self.try_login)
        layout.addWidget(btn)

        self.message = QtWidgets.QLabel("")
        self.message.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.message)

        # Hardcoded credentials for demo
        self._valid_user = "admin"
        self._valid_pass = "password"

    def try_login(self):
        if self.username.text() == self._valid_user and self.password.text() == self._valid_pass:
            self.accept()
        else:
            self.message.setText("Invalid credentials")


# =============================
# STATUS PAGE (dynamic)
# =============================
class StatusPage(QtWidgets.QWidget):
    def __init__(self, name: str, info: str = "No data available"):
        super().__init__()
        layout = QtWidgets.QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.setSpacing(8)

        title = QtWidgets.QLabel(f"Status: {name}")
        title.setObjectName("Title")
        layout.addWidget(title)

        meta = QtWidgets.QLabel(f"Last checked: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        meta.setStyleSheet("font-size:10px; color: #bdbdbd;")
        layout.addWidget(meta)

        self.info_area = QtWidgets.QTextEdit()
        self.info_area.setReadOnly(True)
        self.info_area.setPlainText(info)
        layout.addWidget(self.info_area, 1)

        row = QtWidgets.QHBoxLayout()
        self.refresh_btn = QtWidgets.QPushButton("Refresh")
        self.refresh_btn.clicked.connect(self.refresh_info)
        row.addWidget(self.refresh_btn)

        row.addStretch(1)

        back_btn = QtWidgets.QPushButton("Back")
        back_btn.clicked.connect(self.go_back)
        row.addWidget(back_btn)

        layout.addLayout(row)

    def refresh_info(self):
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        current_text = self.info_area.toPlainText()
        new_line = f"\n[{now}] Refreshed."
        self.info_area.setPlainText(current_text + new_line)

    def go_back(self):
        main_window = self.window()
        if isinstance(main_window, MainWindow):
            main_window.go_to("Home")


# =============================
# HOME PAGE WITH HIERARCHY TREE
# =============================
class HomePage(QtWidgets.QWidget):
    def __init__(self):
        super().__init__()
        layout = QtWidgets.QHBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(8)

        # Left: tree resizable
        self.tree = QtWidgets.QTreeWidget()
        self.tree.setHeaderHidden(True)
        self.tree.setIndentation(16)
        self.tree.setMinimumWidth(250)
        self.tree.setSizePolicy(QtWidgets.QSizePolicy.Policy.Preferred,
                                QtWidgets.QSizePolicy.Policy.Expanding)
        layout.addWidget(self.tree)
        layout.addStretch(1)

        # Example hierarchy (shortened for brevity)
        hierarchy = {
            "UPPER CARRIAGE": {
                "CRADDLE ASSEMBLY": ["CRADDLE STRUCTURE", "TRUNION PIN"],
                "SADDLE ASSEMBLY": ["SADDLE STRUCTURE", "ELEVATION MECHANISM"],
            },
            "UNDER CARRIAGE": {
                "UNDER CARRIAGE ASSEMBLY": {
                    "WHEEL CARRIAGE": ["SUSPENSION UNIT", "TRIANGULAR STAY"],
                },
            },
        }

        def add_items(parent_item, data):
            if isinstance(data, dict):
                for key, val in data.items():
                    if isinstance(val, list):
                        item = QtWidgets.QTreeWidgetItem(parent_item)
                        lbl = QtWidgets.QLabel(key)
                        lbl.setStyleSheet("font-weight:bold;")
                        self.tree.setItemWidget(item, 0, lbl)
                        for child in val:
                            child_item = QtWidgets.QTreeWidgetItem(item)
                            btn = QtWidgets.QPushButton(child)
                            btn.setCursor(QtGui.QCursor(QtCore.Qt.CursorShape.PointingHandCursor))
                            btn.clicked.connect(lambda checked, n=child: self.on_leaf_clicked(n))
                            self.tree.setItemWidget(child_item, 0, btn)
                    else:
                        item = QtWidgets.QTreeWidgetItem(parent_item)
                        lbl = QtWidgets.QLabel(key)
                        self.tree.setItemWidget(item, 0, lbl)

        add_items(self.tree.invisibleRootItem(), hierarchy)
        self.tree.expandAll()

    def on_leaf_clicked(self, name: str):
        main_window = self.window()
        if not isinstance(main_window, MainWindow):
            return

        info = main_window.get_status_info(name)
        if name not in main_window.pages:
            page = StatusPage(name, info)
            main_window.add_dynamic_page(name, page)
        main_window.go_to(name)


