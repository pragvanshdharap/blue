# =============================
# MAIN WINDOW
# =============================
class MainWindow(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Control GUI - Military Grade")
        self.resize(1200, 760)
        self.setMinimumSize(800, 500)
        self.scale_factor = 1.0
        self.setStyleSheet(get_dynamic_style(self.scale_factor))

        central = QtWidgets.QWidget()
        central_layout = QtWidgets.QVBoxLayout(central)
        central_layout.setContentsMargins(0, 0, 0, 0)
        central_layout.setSpacing(0)

        # Topbar
        self.topbar = QtWidgets.QFrame()
        self.topbar.setObjectName("TopBar")
        tlay = QtWidgets.QHBoxLayout(self.topbar)
        tlay.setAlignment(QtCore.Qt.AlignmentFlag.AlignLeft)

        self.top_buttons = {}
        names = ["Home", "Sensors", "STM", "RaspberryPi", "Faults", "Settings"]
        for name in names:
            b = QtWidgets.QPushButton(name)
            b.setCheckable(True)
            b.clicked.connect(lambda checked, n=name: self.go_to(n))
            self.top_buttons[name] = b
            tlay.addWidget(b)

        tlay.addStretch()
        central_layout.addWidget(self.topbar)

        # Pages
        self.stack = QtWidgets.QStackedWidget()
        self.pages = {
            "Home": HomePage(),
            "Sensors": SensorsPage(),
            "STM": AcquisitionPage("STM"),
            "RaspberryPi": AcquisitionPage("RaspberryPi"),
            "Faults": FaultsPage(),
            "Settings": SettingsPage(),
        }
        for key, w in self.pages.items():
            self.stack.addWidget(w)

        central_layout.addWidget(self.stack, 1)

        # Bottom bar
        self.bottombar = QtWidgets.QFrame()
        self.bottombar.setObjectName("BottomBar")
        blay = QtWidgets.QHBoxLayout(self.bottombar)

        self.back_btn = QtWidgets.QPushButton("Back")
        self.next_btn = QtWidgets.QPushButton("Next")
        self.back_btn.clicked.connect(self.go_back)
        self.next_btn.clicked.connect(self.go_next)

        blay.addWidget(self.back_btn)
        blay.addWidget(self.next_btn)

        self.health_label = QtWidgets.QLabel("System Health: Initializing...")
        blay.addStretch()
        blay.addWidget(self.health_label)

        central_layout.addWidget(self.bottombar)
        self.setCentralWidget(central)

        # history
        self.history = []
        self.forward = []

        self._status_info = {
            "SADDLE STRUCTURE": "Saddle Structure: primary support.",
            "ELEVATION MECHANISM": "Elevation actuator nominal.",
        }

        self.go_to("Home", add_history=False)

        # Health updates
        self._health_state = 0
        self.health_timer = QtCore.QTimer(self)
        self.health_timer.timeout.connect(self.update_health)
        self.health_timer.start(1000)

    def resizeEvent(self, event):
        w = self.width()
        self.scale_factor = max(0.8, min(1.6, w / 1200))
        self.setStyleSheet(get_dynamic_style(self.scale_factor))
        super().resizeEvent(event)

    def get_status_info(self, name: str) -> str:
        return self._status_info.get(name, "No info available.")

    def add_dynamic_page(self, name: str, widget: QtWidgets.QWidget):
        if name in self.pages:
            return
        self.pages[name] = widget
        self.stack.addWidget(widget)

    def go_to(self, name: str, add_history: bool = True):
        if name not in self.pages:
            return
        if add_history:
            current = self.stack.currentWidget()
            for k, w in self.pages.items():
                if w == current:
                    self.history.append(k)
                    break
            self.forward.clear()
        self.stack.setCurrentWidget(self.pages[name])
        for k, b in self.top_buttons.items():
            b.setChecked(k == name)

    def go_back(self):
        if not self.history:
            return
        prev = self.history.pop()
        current = self.stack.currentWidget()
        for k, w in self.pages.items():
            if w == current:
                self.forward.append(k)
                break
        self.go_to(prev, add_history=False)

    def go_next(self):
        if not self.forward:
            return
        nxt = self.forward.pop()
        current = self.stack.currentWidget()
        for k, w in self.pages.items():
            if w == current:
                self.history.append(k)
                break
        self.go_to(nxt, add_history=False)

    def update_health(self):
        states = [
            ("System Health: GOOD", PALETTE['health_good']),
            ("System Health: WARNING", PALETTE['health_warn']),
            ("System Health: CRITICAL", PALETTE['health_bad']),
        ]
        msg, col = states[self._health_state]
        self.health_label.setText(msg)
        self.health_label.setStyleSheet(f"color:{col}; font-weight:bold;")
        self._health_state = (self._health_state + 1) % len(states)


# =============================
# RUN APP
# =============================
if __name__ == "__main__":
    app = QtWidgets.QApplication(sys.argv)
    app.setStyle("Fusion")
    login = LoginWindow()
    login.setStyleSheet(get_dynamic_style())
    if login.exec() == QtWidgets.QDialog.DialogCode.Accepted:
        window = MainWindow()
        window.show()
        sys.exit(app.exec())
