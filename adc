## ✅ MAIN CODE (All in `main.c`)

### 1️⃣ Includes and Handles

```c
#include "main.h"
#include <stdio.h>
#include <string.h>

extern SPI_HandleTypeDef hspi1;
extern SPI_HandleTypeDef hspi2;
extern UART_HandleTypeDef huart1;

#define CS1_LOW()   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_RESET)
#define CS1_HIGH()  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, GPIO_PIN_SET)
#define CS2_LOW()   HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET)
#define CS2_HIGH()  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_SET)

uint8_t tx_buf[3] = {0x12, 0x34, 0x56};  // dummy example command
uint8_t rx_buf[24];  // ADS131M08 outputs 3 bytes per channel × 8 = 24 bytes
```

---

### 2️⃣ Function to Send SPI Command and Receive ADC Data

```c
void ADS131_Read(SPI_HandleTypeDef *hspi, uint8_t *rx)
{
    uint8_t tx[24] = {0x00};  // dummy bytes
    HAL_SPI_TransmitReceive(hspi, tx, rx, 24, HAL_MAX_DELAY);
}
```

---

### 3️⃣ UART Print Function

```c
void print_uart(const char* msg)
{
    HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
}
```

---

### 4️⃣ Main Application Logic

```c
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_SPI1_Init();
    MX_SPI2_Init();
    MX_USART1_UART_Init();

    CS1_HIGH();  // idle
    CS2_HIGH();  // idle

    print_uart("Starting ADC read loop...\r\n");

    while (1)
    {
        // --- Read from ADC1 ---
        CS1_LOW();
        HAL_Delay(1);
        ADS131_Read(&hspi1, rx_buf);
        CS1_HIGH();

        char msg[128];
        snprintf(msg, sizeof(msg), "ADC1 CH1: 0x%02X%02X%02X\r\n",
                 rx_buf[0], rx_buf[1], rx_buf[2]);
        print_uart(msg);

        // --- Read from ADC2 ---
        CS2_LOW();
        HAL_Delay(1);
        ADS131_Read(&hspi2, rx_buf);
        CS2_HIGH();

        snprintf(msg, sizeof(msg), "ADC2 CH1: 0x%02X%02X%02X\r\n",
                 rx_buf[0], rx_buf[1], rx_buf[2]);
        print_uart(msg);

        HAL_Delay(500);
    }
}
```

