        print(f"Button clicked: {button_name}")
        # Update tree based on button clicked
        if button_name == "SURVEILLANCE":
            self.highlight_tree_section("👁️ SURVEILLANCE BRANCH")
        elif button_name == "INTEL":
            self.highlight_tree_section("🧠 INTELLIGENCE DIVISION")
        elif button_name == "OPERATIONS":
            self.highlight_tree_section("🎯 OPERATIONS DIVISION")
        elif button_name == "COMMUNICATIONS":
            self.highlight_tree_section("📡 COMMUNICATIONS DIVISION")
        elif button_name == "SYSTEMS":
            self.highlight_tree_section("⚙️ SYSTEMS DIVISION")

    def highlight_tree_section(self, section_name):
        """Highlight and expand specific tree section"""
        # Find and highlight the section
        items = self.tree_widget.findItems(section_name, Qt.MatchFlag.MatchRecursive | Qt.MatchFlag.MatchContains)
        if items:
            item = items[0]
            self.tree_widget.setCurrentItem(item)
            item.setExpanded(True)
            # Scroll to the item
            self.tree_widget.scrollToItem(item)

