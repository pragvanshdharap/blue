    def highlight_tree_section(self, section_name):
        """Highlight and expand specific tree section"""
        # Find and highlight the section
        items = self.tree_widget.findItems(section_name, Qt.MatchFlag.MatchRecursive | Qt.MatchFlag.MatchContains)
        if items:
            item = items[0]
            self.tree_widget.setCurrentItem(item)
            item.setExpanded(True)
            # Scroll to the item
            self.tree_widget.scrollToItem(item)

