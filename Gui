    def center_window(self):
        """Center the window on the screen"""
        screen = QApplication.primaryScreen().geometry()
        window = self.geometry()
        x = (screen.width() - window.width()) // 2
        y = (screen.height() - window.height()) // 2
        self.move(x, y)

    def authenticate(self):
        """Handle authentication attempt"""
        username = self.username_input.text().strip()
        password = self.password_input.text().strip()

        if not username or not password:
            self.show_status("ERROR: INCOMPLETE CREDENTIALS", "#ff5722")
            return

        # Simple authentication check (replace with your actual authentication logic)
        if username.lower() == "admin" and password == "password":
            self.show_status("ACCESS GRANTED", "#4caf50")
            # Emit signal to open main window
            self.login_successful.emit()
            self.hide()
        else:
            self.show_status("ACCESS DENIED: INVALID CREDENTIALS", "#ff5722")
            self.password_input.clear()

    def show_status(self, message, color):
        """Show status message with color"""
        self.status_label.setText(message)
        self.status_label.setStyleSheet(f"""
            font-family: 'Courier New', monospace;
            font-size: 11px;
            font-weight: bold;
            color: {color};
            padding: 8px;
            border-radius: 4px;
            background-color: rgba(255, 255, 255, 0.1);
        """)


