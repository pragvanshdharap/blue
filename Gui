    def init_system_monitoring(self):
        """Initialize system monitoring with random values"""
        self.timer = QTimer()
        self.timer.timeout.connect(self.update_system_status)
        self.timer.start(2000)  # Update every 2 seconds

        # Initial values
        self.update_system_status()

    def update_system_status(self):
        """Update system status with simulated values"""
        # Generate random but realistic values
        cpu_val = random.randint(15, 85)
        mem_val = random.randint(30, 75)
        net_val = random.randint(60, 100)
        sec_val = random.randint(85, 100)

        self.cpu_bar.setValue(cpu_val)
        self.mem_bar.setValue(mem_val)
        self.net_bar.setValue(net_val)
        self.sec_bar.setValue(sec_val)

        # Update overall status based on values
        avg_health = (cpu_val + mem_val + net_val + sec_val) / 4

        if avg_health >= 80:
            self.overall_status.setText("ALL SYSTEMS OPERATIONAL")
            self.overall_status.setStyleSheet("color: #4caf50; font-weight: bold;")
        elif avg_health >= 60:
            self.overall_status.setText("SYSTEMS NOMINAL - MINOR ISSUES")
            self.overall_status.setStyleSheet("color: #ffcc02; font-weight: bold;")
        else:
            self.overall_status.setText("WARNING - SYSTEM DEGRADATION")
            self.overall_status.setStyleSheet("color: #ff5722; font-weight: bold;")

