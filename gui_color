# MAIN WINDOW
# =============================
class MainWindow(QtWidgets.QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Control GUI - Military Grade")
        self.resize(1200, 760)
        self.setStyleSheet(STYLE)

        central = QtWidgets.QWidget()
        central_layout = QtWidgets.QVBoxLayout(central)
        central_layout.setContentsMargins(0, 0, 0, 0)
        central_layout.setSpacing(0)

        # Topbar
        self.topbar = QtWidgets.QFrame()
        self.topbar.setObjectName("TopBar")
        tlay = QtWidgets.QHBoxLayout(self.topbar)
        tlay.setAlignment(QtCore.Qt.AlignmentFlag.AlignLeft)

        self.top_buttons = {}
        names = ["Home", "Sensors", "STM", "RaspberryPi", "Faults", "Settings"]
        for name in names:
            b = QtWidgets.QPushButton(name)
            b.setCheckable(True)
            b.clicked.connect(lambda checked, n=name: self.go_to(n))
            self.top_buttons[name] = b
            tlay.addWidget(b)

        tlay.addStretch()
        central_layout.addWidget(self.topbar)

        # Pages (predefined)
        self.stack = QtWidgets.QStackedWidget()
        self.pages = {
            "Home": HomePage(),
            "Sensors": SensorsPage(),
            "STM": AcquisitionPage("STM"),
            "RaspberryPi": AcquisitionPage("RaspberryPi"),
            "Faults": FaultsPage(),
            "Settings": SettingsPage(),
        }
        for key, w in self.pages.items():
            self.stack.addWidget(w)

        central_layout.addWidget(self.stack, 1)

        # Bottom bar (health, back/next)
        self.bottombar = QtWidgets.QFrame()
        self.bottombar.setObjectName("BottomBar")
        blay = QtWidgets.QHBoxLayout(self.bottombar)

        self.back_btn = QtWidgets.QPushButton("Back")
        self.next_btn = QtWidgets.QPushButton("Next")
        self.back_btn.clicked.connect(self.go_back)
        self.next_btn.clicked.connect(self.go_next)

        blay.addWidget(self.back_btn)
        blay.addWidget(self.next_btn)

        self.health_label = QtWidgets.QLabel("System Health: Initializing...")
        blay.addStretch()
        blay.addWidget(self.health_label)

        central_layout.addWidget(self.bottombar)
        self.setCentralWidget(central)

        # history stacks (names)
        self.history = []
        self.forward = []

        # sample status info — extend with any leaf names you want
        self._status_info = {
            "SADDLE STRUCTURE": "Saddle Structure: primary support for gun mount. Inspect welds & fasteners.",
            "ELEVATION MECHANISM": "Elevation actuator status: hydraulic pressure nominal.",
            "TRAVERSE MECHANISM": "Traverse gearbox temperature 46°C; lubrication OK.",
            "CRADDLE STRUCTURE": "Craddle structure: minor surface corrosion found; schedule maintenance.",
            "TRUNION PIN": "Trunion pin: wear within tolerance.",
            "HUB REDUCTION GEAR": "Hub reduction gear: oil level normal.",
            "SUSPENSION UNIT": "Suspension unit: shock absorbers nominal.",
            "TRIANGULAR STAY": "Triangular stay: structural element, no issues reported.",
            "TRAIL TRAVERSING CYLINDER": "Trail traversing cylinder: hydraulic seals checked.",
        }

        self.go_to("Home", add_history=False)

        # start health timer
        self._health_state = 0
        self.health_timer = QtCore.QTimer(self)
        self.health_timer.timeout.connect(self.update_health)
        self.health_timer.start(1000)

    def get_status_info(self, name: str) -> str:
        return self._status_info.get(name, "No info available for this item yet.")

    def add_dynamic_page(self, name: str, widget: QtWidgets.QWidget):
        """Add a dynamically created page (StatusPage) to the pages dict and stack."""
        if name in self.pages:
            return
        self.pages[name] = widget
        self.stack.addWidget(widget)

    def go_to(self, name: str, add_history: bool = True):
        """Navigate by page name. Uses pages dict to find widget instance."""
        if name not in self.pages:
            return

        widget = self.pages[name]
        index = self.stack.indexOf(widget)
        if index == -1:
            return

        if add_history:
            if len(self.history) == 0 or self.history[-1] != name:
                self.history.append(name)
            self.forward.clear()

        self.stack.setCurrentIndex(index)

        # highlight top buttons if the page is a top-level page
        for n, btn in self.top_buttons.items():
            if n == name:
                btn.setChecked(True)
                btn.setStyleSheet(f"background: {PALETTE['active']}; color: black; font-weight: bold;")
            else:
                btn.setChecked(False)
                btn.setStyleSheet("")

        # show/hide navigation controls
        if name == "Home":
            self.back_btn.hide()
            self.next_btn.hide()
        else:
            self.back_btn.setVisible(len(self.history) > 1)
            self.next_btn.setVisible(len(self.forward) > 0)

    def go_back(self):
        if len(self.history) > 1:
            cur = self.history.pop()
            self.forward.append(cur)
            prev = self.history[-1]
            self.go_to(prev, add_history=False)

    def go_next(self):
        if len(self.forward) > 0:
            nxt = self.forward.pop()
            self.history.append(nxt)
            self.go_to(nxt, add_history=False)

    def update_health(self):
        self._health_state = (self._health_state + 1) % 10
        if self._health_state < 7:
            status = "HEALTHY"
            color = PALETTE['health_good']
        elif self._health_state < 9:
            status = "WARN"
            color = PALETTE['health_warn']
        else:
            status = "CRITICAL"
            color = PALETTE['health_bad']

        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.health_label.setText(f"System Health: {status} | {now}")
        self.health_label.setStyleSheet(f"font-weight:bold; color: {color};")


