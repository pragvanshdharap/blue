# =============================
# LOGIN WINDOW
# =============================
class LoginWindow(QtWidgets.QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Login")
        self.setFixedSize(360, 200)
        self.setStyleSheet(STYLE)

        layout = QtWidgets.QVBoxLayout(self)

        title = QtWidgets.QLabel("Secure GUI Login")
        title.setObjectName("Title")
        title.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title)

        form = QtWidgets.QFormLayout()
        self.username = QtWidgets.QLineEdit()
        self.password = QtWidgets.QLineEdit()
        self.password.setEchoMode(QtWidgets.QLineEdit.EchoMode.Password)
        form.addRow("Username:", self.username)
        form.addRow("Password:", self.password)
        layout.addLayout(form)

        btn = QtWidgets.QPushButton("Login")
        btn.clicked.connect(self.try_login)
        layout.addWidget(btn)

        self.message = QtWidgets.QLabel("")
        self.message.setAlignment(QtCore.Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.message)

        # Hardcoded credentials for demo
        self._valid_user = "admin"
        self._valid_pass = "password"

    def try_login(self):
        if self.username.text() == self._valid_user and self.password.text() == self._valid_pass:
            self.accept()
        else:
            self.message.setText("Invalid credentials")


# =============================
# STATUS PAGE (dynamic)
# =============================
class StatusPage(QtWidgets.QWidget):
    def __init__(self, name: str, info: str = "No data available"):
        super().__init__()
        self.name = name
        self.setStyleSheet(STYLE)
        layout = QtWidgets.QVBoxLayout(self)
        layout.setContentsMargins(12, 12, 12, 12)
        layout.setSpacing(8)

        title = QtWidgets.QLabel(f"Status: {name}")
        title.setObjectName("Title")
        layout.addWidget(title)

        meta = QtWidgets.QLabel(f"Last checked: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        meta.setStyleSheet("font-size:10px; color: #bdbdbd;")
        layout.addWidget(meta)

        self.info_area = QtWidgets.QTextEdit()
        self.info_area.setReadOnly(True)
        self.info_area.setPlainText(info)
        layout.addWidget(self.info_area, 1)

        row = QtWidgets.QHBoxLayout()
        self.refresh_btn = QtWidgets.QPushButton("Refresh")
        self.refresh_btn.clicked.connect(self.refresh_info)
        row.addWidget(self.refresh_btn)

        row.addStretch(1)

        back_btn = QtWidgets.QPushButton("Back")
        back_btn.clicked.connect(self.go_back)
        row.addWidget(back_btn)

        layout.addLayout(row)

    def refresh_info(self):
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        current_text = self.info_area.toPlainText()
        new_line = f"\n[{now}] Refreshed."
        self.info_area.setPlainText(current_text + new_line)

    def go_back(self):
        main_window = self.window()
        if isinstance(main_window, MainWindow):
            main_window.go_to("Home")


