class SensorsPage(QtWidgets.QWidget):
    def __init__(self):
        super().__init__()
        self.setStyleSheet(STYLE)
        main = QtWidgets.QHBoxLayout(self)

        left_frame = QtWidgets.QFrame()
        left_frame.setFixedWidth(160)
        left_layout = QtWidgets.QVBoxLayout(left_frame)
