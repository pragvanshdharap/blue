                    "TRAVERSE MECHANISM",
                    "LAYER'S STATION",
                    "LOADER'S STATION",
                    "ELEVATION ACTUATOR",
                    "SLEW BEARING",
                    "LOADING TABLE",
                    "AMMUNITION CRANE",
                ],
            },
            "UNDER CARRIAGE": {
                "UNDER CARRIAGE ASSEMBLY": {
                    "WHEEL CARRIAGE & SUSPENSION UNIT": {
                        "SUSPENSION UNIT": [],
                        "TRIANGULAR STAY": [],
                        "WHEEL CARRIAGE WITH DRIVE UNIT": {
                            "DRIVE UNIT ASSEMBLY": [
                                "HUB REDUCTION GEAR",
                                "HYDRAULIC MOTOR",
