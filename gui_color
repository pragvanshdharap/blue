                    },
                    "AUXILLARY POWER UNIT": {
                        "ENGINE UNIT": [
                            "ENGINE_UNIT",
                            "FUEL UNIT",
                            "EXHAUST SYSTEM",
                            "AIR INTAKE SYSTEM",
                            "COOLING SYSTEM",
                        ],
                        "PUMP UNIT": [
                            "HYDRAULIC TANK",
                            "ELECTRO HYDRAULIC",
                            "PUMP",
                            "PUMP PISTON GEAR",
                            "VALVE PANEL",
                            "VALVE BLOCK",
                        ],
                        "BATTERY UNIT": [
                            "ELECTRICAL SYSTEM",
                            "BATTERY COMPONENT",
                            "JUNCTION BOX",
                            "ALTERNATOR",
                            "POWER ELECTRONICS",
                        ],
                    },
                },
                "UNDER_CARRIAGE": [
                    "CHASSIS",
                    "SLEWING BEARING",
                    "CENTRAL PLATFORM",
                ],
                "TRAIL TRAVERSING CYLINDER": [],
                "TRAIL ASSEMBLY": [
                    "TRAIL LEFT & RIGHT",
                    "TRAIL SPADE LEFT & RIGHT",
                    "CASTOR WHEEL LEFT & RIGHT",
                    "HYDRAULIC CYLINDER CASTOR WHEEL",
                    "LOCKING BAR TRAILS",
                ],
                "DRAWBAR ASSEMBLY": [
                    "UPPER LOWER LINK",
                    "CLAMP",
                    "TOWING EYE",
                    "LOCKING CRANK",
                ],
                "HYDRAULIC ELECTRIC": [],
            },
        }

        # recursive builder: dict -> nesting; list -> leaf buttons; empty list -> button on key
        def add_items(parent_item, data):
            if isinstance(data, dict):
                for key, val in data.items():
                    # if val is an empty list, key itself is a leaf button
                    if isinstance(val, list) and len(val) == 0:
                        item = QtWidgets.QTreeWidgetItem(parent_item)
                        btn = QtWidgets.QPushButton(key)
                        btn.setCursor(QtGui.QCursor(QtCore.Qt.CursorShape.PointingHandCursor))
                        btn.clicked.connect(lambda checked, n=key: self.on_leaf_clicked(n))
                        self.tree.setItemWidget(item, 0, btn)
                    elif isinstance(val, list):
                        # key is a parent label, its elements are leaves (strings)
                        item = QtWidgets.QTreeWidgetItem(parent_item)
                        lbl = QtWidgets.QLabel(key)
                        lbl.setStyleSheet("font-weight:bold;")
                        self.tree.setItemWidget(item, 0, lbl)
                        for child in val:
                            child_item = QtWidgets.QTreeWidgetItem(item)
                            btn = QtWidgets.QPushButton(child)
                            btn.setCursor(QtGui.QCursor(QtCore.Qt.CursorShape.PointingHandCursor))
                            btn.clicked.connect(lambda checked, n=child: self.on_leaf_clicked(n))
                            self.tree.setItemWidget(child_item, 0, btn)
                    elif isinstance(val, dict):
                        item = QtWidgets.QTreeWidgetItem(parent_item)
                        lbl = QtWidgets.QLabel(key)
                        lbl.setStyleSheet("font-weight:bold;")
                        self.tree.setItemWidget(item, 0, lbl)
                        add_items(item, val)
                    else:
                        # fallback
                        item = QtWidgets.QTreeWidgetItem(parent_item)
                        lbl = QtWidgets.QLabel(str(key))
                        self.tree.setItemWidget(item, 0, lbl)
            elif isinstance(data, list):
                for val in data:
                    item = QtWidgets.QTreeWidgetItem(parent_item)
                    btn = QtWidgets.QPushButton(val)
                    btn.setCursor(QtGui.QCursor(QtCore.Qt.CursorShape.PointingHandCursor))
                    btn.clicked.connect(lambda checked, n=val: self.on_leaf_clicked(n))
                    self.tree.setItemWidget(item, 0, btn)
            else:
                QtWidgets.QTreeWidgetItem(parent_item, [str(data)])

        add_items(self.tree.invisibleRootItem(), hierarchy)
        self.tree.expandAll()

    def on_leaf_clicked(self, name: str):
        main_window = self.window()
        if not isinstance(main_window, MainWindow):
            return

        info = main_window.get_status_info(name)
        # create a StatusPage dynamically if it doesn't exist
        if name not in main_window.pages:
            page = StatusPage(name, info)
            main_window.add_dynamic_page(name, page)
        main_window.go_to(name)


