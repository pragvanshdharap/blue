# APP ENTRY
# =============================
def main():
    app = QtWidgets.QApplication(sys.argv)
    app.setStyleSheet(STYLE)

    login = LoginWindow()
    if login.exec() == QtWidgets.QDialog.Accepted:
        w = MainWindow()
        w.show()
        sys.exit(app.exec())
    else:
        sys.exit(0)


if __name__ == "__main__":
    main()
